# Cloudflare Turnstile (contact form captcha)
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# Without these the form still works in dev, but captcha is skipped.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Canonical env (preferred) — route accepts either TURNSTILE_SECRET or
# TURNSTILE_SECRET_KEY. Set TURNSTILE_SECRET in production.
TURNSTILE_SECRET=
# Comma-separated frontend hostnames that siteverify must return in
# `hostname`. Production should list only prod domains (e.g. parmjeetmishra.com)
# and MUST NOT include localhost. For local dev add localhost,127.0.0.1.
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,parmjeetmishra.com

# Ask Parm chatbot (/api/chat) — runs through an OpenAI-compatible provider:
# OpenRouter or Fireworks. Set the key for whichever you use; if both are set,
# CHAT_PROVIDER (or OpenRouter by default) decides. Without any key the chatbot
# replies with a "not connected" notice.
#
# CHAT_PROVIDER is optional: "openrouter" | "fireworks". Leave blank to
# auto-detect from whichever key is present (OpenRouter wins if both are).
CHAT_PROVIDER=

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Any OpenRouter model slug. Defaults to meta-llama/llama-3.3-70b-instruct.
OPENROUTER_MODEL=

# Fireworks — https://fireworks.ai/account/api-keys
FIREWORKS_API_KEY=
# Any Fireworks model. Defaults to accounts/fireworks/models/llama-v3p3-70b-instruct.
FIREWORKS_MODEL=

# Upstash Redis — per-IP rate limiting for the chatbot AND the contact form.
# Without these, rate limiting is skipped (fine for dev, NOT for production).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Resend — transactional email for the contact form
# https://resend.com/api-keys
RESEND_API_KEY=
# The email address that receives submissions from the contact form
CONTACT_EMAIL=iamparmjeetmishra@gmail.com
# Optional: Sender email (defaults to "Portfolio Contact <onboarding@resend.dev>")
# When your domain is verified on Resend, change to e.g. "Parmjeet Mishra <contact@parmjeetmishra.com>"
RESEND_FROM_EMAIL=
